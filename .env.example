# URL del API (usada por el navegador para llamadas API)
# NEXT_PUBLIC_API_URL=http://100.127.113.86:5107

# Cuando la PWA corre en OTRA PC (ej. la de tu compañero) pero las imágenes del POD
# están en TU PC, define la URL de tu PC (Tailscale) aquí. El proxy /api/pod-image
# pedirá las imágenes a esta URL.
# POD_IMAGE_API_URL=http://100.x.x.x:5107
